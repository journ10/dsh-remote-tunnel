# Copy to .env and fill in the values. install.sh generates this file for you.
# Never commit .env: it contains the instance token and cookie signing secret.

# Public relay hostname. Must resolve to this server.
PUBLIC_HOST=relay.example.com

# Instance hosts are <instance-id>.INSTANCE_BASE_DOMAIN.
INSTANCE_BASE_DOMAIN=relay.example.com

# Public origin used to build pairing URLs. Production must use https://.
PUBLIC_URL=https://relay.example.com

# ACME account e-mail for Caddy.
ACME_EMAIL=you@example.com

# 32+ random characters. install.sh generates one.
COOKIE_SECRET=

# Bootstrap instance. install.sh generates a random token and public host.
BOOTSTRAP_INSTANCE_ID=default
BOOTSTRAP_INSTANCE_TOKEN=
BOOTSTRAP_PUBLIC_HOST=default.relay.example.com

# Cookies must be Secure in production.
COOKIE_SECURE=true

# Optional limits and windows.
PAIR_TTL_MS=120000
PAIR_CODE_LENGTH=10
DEVICE_COOKIE_DAYS=30
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=536870912
MAX_WS_MESSAGE_BYTES=8388608
TRUST_PROXY=true
LOG_LEVEL=info
