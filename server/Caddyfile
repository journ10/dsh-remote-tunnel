# Caddy is the only public listener. It terminates TLS for the relay host and
# every instance host, then forwards to the relay process on the Compose network.
#
# Wildcard DNS is required: relay.example.com and *.relay.example.com must both
# resolve to this server. Caddy obtains each certificate on demand and asks the
# relay whether the hostname is a configured instance before requesting one.
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://relay:8080/internal/tls/ask
	}
}

https:// {
	tls {
		on_demand
	}

	reverse_proxy relay:8080 {
		# Do not buffer event streams or WebSocket frames.
		flush_interval -1
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# No access log: pairing URLs and query strings must not reach disk.
}
